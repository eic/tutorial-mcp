#!/usr/bin/env bash
#
# eic-mcp — provision and run the EIC MCP servers (uproot, xrootd, rucio)
#           as local HTTP/SSE services for an LLM client (e.g. opencode).
#
# Run it INSIDE eic-shell, where Python 3.13, Node, xrdfs and a
# pre-authenticated `rucio` (account: eicread) are already available. It also
# works from the host if you point it at the eic_xl .sif (EIC_MCP_SIF).
#
#   eic-mcp setup     # one-time: clone (if needed) + build venvs/node deps
#   eic-mcp up        # start all three SSE servers in the background
#   eic-mcp status    # show which servers are listening
#   eic-mcp logs NAME # tail a server log (uproot|xrootd|rucio)
#   eic-mcp down      # stop all three
#   eic-mcp restart   # down + up
#
# Servers listen on localhost only:
#   uproot  http://127.0.0.1:9101/sse
#   xrootd  http://127.0.0.1:9102/sse
#   rucio   http://127.0.0.1:9103/sse
#
# NOTE: until the SSE changes are merged upstream, point setup at the branches
# that contain them, e.g.  XROOTD_BRANCH=feat/sse-transport eic-mcp setup

set -euo pipefail

# ---- config (all overridable from the environment) ------------------------
EIC_MCP_DIR="${EIC_MCP_DIR:-$HOME/eic-mcp/servers}"   # where the 3 repos live
EIC_MCP_STATE="${EIC_MCP_STATE:-$HOME/.eic-mcp}"      # pid + log files
RUN_DIR="$EIC_MCP_STATE/run"; LOG_DIR="$EIC_MCP_STATE/logs"

UPROOT_PORT="${UPROOT_PORT:-9101}"
XROOTD_PORT="${XROOTD_PORT:-9102}"
RUCIO_PORT="${RUCIO_PORT:-9103}"
BIND_HOST="${EIC_MCP_HOST:-127.0.0.1}"

XROOTD_SERVER="${XROOTD_SERVER:-root://dtn-eic.jlab.org}"
XROOTD_BASE_DIR="${XROOTD_BASE_DIR:-/volatile/eic/EPIC}"

UPROOT_REPO_URL="${UPROOT_REPO_URL:-https://github.com/eic/uproot-mcp-server}"
XROOTD_REPO_URL="${XROOTD_REPO_URL:-https://github.com/eic/xrootd-mcp-server}"
RUCIO_REPO_URL="${RUCIO_REPO_URL:-https://github.com/eic/rucio-eic-mcp-server}"
UPROOT_BRANCH="${UPROOT_BRANCH:-}"; XROOTD_BRANCH="${XROOTD_BRANCH:-}"; RUCIO_BRANCH="${RUCIO_BRANCH:-}"

EIC_MCP_SIF="${EIC_MCP_SIF:-}"
RUCIO_CFG="${RUCIO_CFG:-/opt/rucio/etc/rucio.cfg}"

UPROOT_DIR="$EIC_MCP_DIR/uproot-mcp-server"
XROOTD_DIR="$EIC_MCP_DIR/xrootd-mcp-server"
RUCIO_DIR="$EIC_MCP_DIR/rucio-eic-mcp-server"

# ---- run inside the EIC software stack ------------------------------------
in_container() {
  [ -n "${APPTAINER_CONTAINER:-}" ] || [ -n "${SINGULARITY_CONTAINER:-}" ] \
    || [ -e /.singularity.d ] || [ -e /singularity ]
}

find_sif() {
  [ -n "$EIC_MCP_SIF" ] && { echo "$EIC_MCP_SIF"; return; }
  for p in "$HOME/dev/eic/local/lib/eic_xl-nightly.sif" \
           "$HOME/eic/local/lib/eic_xl-nightly.sif" \
           "$PWD/local/lib/eic_xl-nightly.sif"; do
    [ -e "$p" ] && { echo "$p"; return; }
  done
  echo ""
}

run_in_env() {  # "<command string>"
  if in_container; then bash -lc "$1"; else
    local sif; sif="$(find_sif)"
    [ -z "$sif" ] && { echo "ERROR: not inside eic-shell and no eic_xl .sif found (set EIC_MCP_SIF)." >&2; exit 1; }
    apptainer exec "$sif" bash -lc "$1"
  fi
}

run_in_env_bg() {  # cmd pidfile logfile
  local cmd="$1" pidfile="$2" logfile="$3"
  if in_container; then
    nohup bash -lc "$cmd" >"$logfile" 2>&1 & echo $! >"$pidfile"
  else
    local sif; sif="$(find_sif)"
    nohup apptainer exec "$sif" bash -lc "$cmd" >"$logfile" 2>&1 & echo $! >"$pidfile"
  fi
}

# True if something is listening on the port. We test the TCP connection
# rather than completing an HTTP GET, because an SSE stream never closes and
# would make a normal curl hang/timeout (which is *not* a failure).
port_open() { timeout 2 bash -c "exec 3<>/dev/tcp/$BIND_HOST/$1" 2>/dev/null; }

wait_ready() {  # name port timeout
  local name="$1" port="$2" timeout="${3:-30}" i
  for ((i = 1; i <= timeout; i++)); do
    port_open "$port" && { echo "  ✓ $name ready on http://$BIND_HOST:$port/sse"; return 0; }
    sleep 1
  done
  echo "  ✗ $name did NOT come up on port $port within ${timeout}s (see: eic-mcp logs $name)" >&2
  return 1
}

# Export the same Rucio creds the eic-shell CLI uses, straight from rucio.cfg.
rucio_env_snippet() {
  cat <<PY
eval "\$(python3 - <<'EOF'
import configparser, shlex
c = configparser.ConfigParser(); c.read("$RUCIO_CFG")
g = lambda k, d="": c.get("client", k, fallback=d)
print("export RUCIO_URL="       + shlex.quote(g("rucio_host", "https://rucio-server.jlab.org:443")))
print("export RUCIO_AUTH_TYPE=userpass")
print("export RUCIO_USERNAME="  + shlex.quote(g("username", "eicread")))
print("export RUCIO_PASSWORD="  + shlex.quote(g("password", "eicread")))
print("export RUCIO_ACCOUNT="   + shlex.quote(g("account",  g("username", "eicread"))))
print("export RUCIO_VO=")
EOF
)"
PY
}

# ---- commands -------------------------------------------------------------
cmd_setup() {
  mkdir -p "$EIC_MCP_DIR" "$RUN_DIR" "$LOG_DIR"
  clone_if_missing() {  # dir url branch
    if [ -d "$1/.git" ]; then echo "==> $(basename "$1"): present (using local checkout)";
    elif [ -n "$3" ]; then echo "==> cloning $(basename "$1") ($3)"; git clone --branch "$3" "$2" "$1";
    else echo "==> cloning $(basename "$1")"; git clone "$2" "$1"; fi
  }
  clone_if_missing "$UPROOT_DIR" "$UPROOT_REPO_URL" "$UPROOT_BRANCH"
  clone_if_missing "$XROOTD_DIR" "$XROOTD_REPO_URL" "$XROOTD_BRANCH"
  clone_if_missing "$RUCIO_DIR"  "$RUCIO_REPO_URL"  "$RUCIO_BRANCH"

  echo "==> uproot: venv (--system-site-packages reuses container uproot/awkward/numpy)"
  run_in_env "cd '$UPROOT_DIR' && { [ -d .venv-eic ] || python3 -m venv --system-site-packages .venv-eic; } && ./.venv-eic/bin/pip -q install -e ."
  echo "==> rucio: venv (--system-site-packages reuses container rucio client)"
  run_in_env "cd '$RUCIO_DIR' && { [ -d .venv-eic ] || python3 -m venv --system-site-packages .venv-eic; } && ./.venv-eic/bin/pip -q install ."
  echo "==> xrootd: npm install + build"
  run_in_env "cd '$XROOTD_DIR' && { [ -d node_modules ] || npm install; } && npm run build"
  echo; echo "Setup complete. Start with:  eic-mcp up"
}

cmd_up() {
  mkdir -p "$RUN_DIR" "$LOG_DIR"
  echo "Starting EIC MCP servers (SSE) ..."
  run_in_env_bg "cd '$UPROOT_DIR' && exec ./.venv-eic/bin/uproot-mcp-server --transport sse --host $BIND_HOST --port $UPROOT_PORT" \
    "$RUN_DIR/uproot.pid" "$LOG_DIR/uproot.log"
  run_in_env_bg "cd '$XROOTD_DIR' && export MCP_TRANSPORT=sse MCP_HOST=$BIND_HOST MCP_PORT=$XROOTD_PORT XROOTD_SERVER='$XROOTD_SERVER' XROOTD_BASE_DIR='$XROOTD_BASE_DIR' && exec node build/src/index.js" \
    "$RUN_DIR/xrootd.pid" "$LOG_DIR/xrootd.log"
  run_in_env_bg "cd '$RUCIO_DIR' && $(rucio_env_snippet) && exec ./.venv-eic/bin/rucio-eic-mcp --transport sse --host $BIND_HOST --port $RUCIO_PORT" \
    "$RUN_DIR/rucio.pid" "$LOG_DIR/rucio.log"

  echo "Waiting for servers (uproot loads uproot/awkward, ~10s on first start) ..."
  local rc=0
  wait_ready uproot "$UPROOT_PORT" 40 || rc=1
  wait_ready xrootd "$XROOTD_PORT" 20 || rc=1
  wait_ready rucio  "$RUCIO_PORT"  20 || rc=1
  echo
  [ "$rc" -eq 0 ] && echo "All servers up. Set opencode.jsonc next to where you run 'opencode'." \
                  || echo "One or more servers failed — check 'eic-mcp logs <name>'." >&2
  return $rc
}

pid_on_port() { command -v ss >/dev/null 2>&1 || return 0; ss -ltnpH "sport = :$1" 2>/dev/null | grep -oP 'pid=\K[0-9]+' | head -1; }

stop_one() {  # name
  local name="$1" pidfile="$RUN_DIR/$1.pid" port pid i
  case "$name" in uproot) port=$UPROOT_PORT;; xrootd) port=$XROOTD_PORT;; rucio) port=$RUCIO_PORT;; esac
  if [ -f "$pidfile" ]; then
    pid="$(cat "$pidfile")"
    kill "$pid" 2>/dev/null || true
    for ((i = 0; i < 6; i++)); do port_open "$port" || break; sleep 1; done
    port_open "$port" && kill -9 "$pid" 2>/dev/null || true
    rm -f "$pidfile"
  fi
  if port_open "$port"; then pid="$(pid_on_port "$port")"; [ -n "$pid" ] && kill -9 "$pid" 2>/dev/null || true; fi
  echo "  stopped $name"
}

cmd_down()   { echo "Stopping EIC MCP servers ..."; stop_one uproot; stop_one xrootd; stop_one rucio; }
cmd_status() {
  printf "%-8s %-30s %s\n" SERVER URL STATE
  for s in "uproot $UPROOT_PORT" "xrootd $XROOTD_PORT" "rucio $RUCIO_PORT"; do
    set -- $s; port_open "$2" && st=UP || st=down
    printf "%-8s %-30s %s\n" "$1" "http://$BIND_HOST:$2/sse" "$st"
  done
}
cmd_logs() { local n="${1:-}"; [ -z "$n" ] && { echo "usage: eic-mcp logs <uproot|xrootd|rucio>" >&2; exit 2; }; exec tail -n 100 -f "$LOG_DIR/$n.log"; }

case "${1:-}" in
  setup)   cmd_setup ;;
  up)      cmd_up ;;
  down)    cmd_down ;;
  restart) cmd_down; sleep 1; cmd_up ;;
  status)  cmd_status ;;
  logs)    shift; cmd_logs "${1:-}" ;;
  ""|-h|--help|help) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "Unknown command: $1" >&2; echo "Try: eic-mcp help" >&2; exit 2 ;;
esac
