{
  "//": "GitHub Copilot CLI MCP configuration.",
  "//1": "Save as ~/.copilot/mcp-config.json (or pass with --additional-mcp-config), then run",
  "//2": "the Copilot CLI from your project root so the ./files/data mount resolves:",
  "//3": "  copilot -p \"...your request...\" --allow-all",
  "//4": "Same docker payload as every other client; only the wrapper differs.",
  "mcpServers": {
    "uproot": {
      "type": "local",
      "command": "docker",
      "args": ["run", "-i", "--rm",
               "-v", "./files/data:/data",
               "ghcr.io/eic/uproot-mcp-server:latest"],
      "tools": ["*"]
    },
    "xrootd": {
      "type": "local",
      "command": "docker",
      "args": ["run", "-i", "--rm",
               "-e", "XROOTD_SERVER", "-e", "XROOTD_BASE_DIR",
               "ghcr.io/eic/xrootd-mcp-server:latest"],
      "env": {
        "XROOTD_SERVER": "root://dtn-eic.jlab.org",
        "XROOTD_BASE_DIR": "/volatile/eic/EPIC"
      },
      "tools": ["*"]
    }
  }
}
