{
  // opencode config for the three EIC MCP servers. `eic-mcp config opencode` writes it
  // in the directory where you launch `opencode`; start the servers first with
  // `eic-mcp up` inside eic-shell. The URLs work inside and outside eic-shell.
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "uproot": { "type": "remote", "url": "http://127.0.0.1:9101/mcp", "enabled": true },
    "xrootd": { "type": "remote", "url": "http://127.0.0.1:9102/mcp", "enabled": true },
    "rucio":  { "type": "remote", "url": "http://127.0.0.1:9103/mcp", "enabled": true }
  }
}
